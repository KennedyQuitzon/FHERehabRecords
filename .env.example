# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Sepolia Testnet RPC URL (Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# Mainnet RPC URL (for production - use with caution)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key

# Local network URL
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Private Key (DO NOT COMMIT - Use a dedicated deployment wallet)
# Never use your main wallet's private key
PRIVATE_KEY=your_private_key_without_0x_prefix

# Mnemonic (alternative to private key)
# MNEMONIC=your twelve word mnemonic phrase here

# =============================================================================
# CONTRACT VERIFICATION
# =============================================================================

# Etherscan API Key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# =============================================================================
# DEPLOYED CONTRACT ADDRESSES
# =============================================================================

# Main contract address (filled after deployment)
CONTRACT_ADDRESS=

# Proxy contract address (if using upgradeable contracts)
PROXY_ADDRESS=

# =============================================================================
# ROLE ADDRESSES
# =============================================================================

# Contract Owner Address
OWNER_ADDRESS=

# Pauser Role Address (for emergency stops)
PAUSER_ADDRESS=

# Admin Addresses (comma-separated for multiple admins)
ADMIN_ADDRESSES=

# Therapist Addresses (for testing)
THERAPIST_ADDRESS=
THERAPIST_ADDRESS_2=

# Patient Addresses (for testing)
PATIENT_ADDRESS=
PATIENT_ADDRESS_2=

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Enable/disable security features
ENABLE_RATE_LIMITING=true
ENABLE_ACCESS_CONTROL=true
ENABLE_EMERGENCY_PAUSE=true

# Rate limiting configuration
MAX_REQUESTS_PER_MINUTE=60
MAX_RECORDS_PER_BATCH=100

# Gas price limits (in gwei)
MAX_GAS_PRICE=100
MIN_GAS_PRICE=1

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================

# Enable gas reporting
REPORT_GAS=false

# Gas reporter currency
GAS_REPORTER_CURRENCY=USD

# Codecov token for coverage reports
CODECOV_TOKEN=

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Enable fork testing
ENABLE_FORKING=false

# Fork from specific block number
FORK_BLOCK_NUMBER=

# Test network chain ID
TEST_CHAIN_ID=31337

# =============================================================================
# OPTIMIZATION SETTINGS
# =============================================================================

# Solidity optimizer runs (higher = more optimized for runtime)
OPTIMIZER_RUNS=200

# Enable viaIR compilation
ENABLE_VIA_IR=true

# Contract size limit warning threshold (in KB)
CONTRACT_SIZE_LIMIT=24

# =============================================================================
# CI/CD CONFIGURATION
# =============================================================================

# GitHub token for automated workflows
GITHUB_TOKEN=

# Deployment environment (development, staging, production)
DEPLOYMENT_ENV=development

# Enable automatic deployment
AUTO_DEPLOY=false

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================

# Slack webhook for notifications
SLACK_WEBHOOK_URL=

# Discord webhook for notifications
DISCORD_WEBHOOK_URL=

# Email for critical alerts
ALERT_EMAIL=

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Enable debug mode
DEBUG=false

# Verbose logging
VERBOSE=false

# Dry run mode (simulate without executing)
DRY_RUN=false

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit this file with real values
# 2. Use separate .env files for different environments
# 3. Rotate private keys and API keys regularly
# 4. Use hardware wallets for production deployments
# 5. Enable all security features in production
# 6. Monitor gas prices before deployment
# 7. Test thoroughly on testnet before mainnet deployment
# =============================================================================
