#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Validate commit message format
# Format: type(scope): message
# Example: feat(contracts): add new record validation

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Regex for conventional commits
commit_regex='^(feat|fix|docs|style|refactor|perf|test|chore|revert)(\(.+\))?: .{1,100}'

if ! echo "$commit_msg" | grep -qE "$commit_regex"; then
    echo "❌ Invalid commit message format"
    echo ""
    echo "Commit message must follow conventional commits format:"
    echo "  type(scope): message"
    echo ""
    echo "Types: feat, fix, docs, style, refactor, perf, test, chore, revert"
    echo ""
    echo "Examples:"
    echo "  feat(contracts): add patient validation"
    echo "  fix(tests): correct edge case handling"
    echo "  docs(readme): update deployment guide"
    echo ""
    exit 1
fi

echo "✅ Commit message format validated"
